# SeatSync API environment configuration.
# Copy this file to .env before running the API: Copy-Item .env.example .env
# Required: DATABASE_URL, REDIS_URL, JWT_SECRET, PAYMENT_WEBHOOK_SECRET.
# POSTGRES_* must stay in sync with the compose `db` service and with DATABASE_URL.
POSTGRES_USER=seatsync
POSTGRES_PASSWORD=seatsync
POSTGRES_DB=seatsync

DATABASE_URL=postgres://seatsync:seatsync@localhost:5434/seatsync
REDIS_URL=redis://localhost:6379
DB_POOL_SIZE=20
JWT_SECRET=dev-jwt-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
HOLD_TTL_SECONDS=600
SWEEPER_INTERVAL_SECONDS=30
MAX_SEATS_PER_HOLD=6
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# Razorpay API credentials: required only when PAYMENT_PROVIDER=razorpay.
# Leave both unset for the fake provider. Never commit real keys.
# RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
# RAZORPAY_KEY_SECRET=placeholder_key_secret
HOLDS_RATE_LIMIT_PER_MINUTE=20
CORS_ORIGINS=http://localhost:3000
LIVE_UPDATE_MAX_MS=1000
RETENTION_DAYS=30
