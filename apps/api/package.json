{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "SeatSync HTTP API",
  "scripts": {
    "dev": "node -r dotenv/config --env-file-if-exists=../../.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "migrate": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations -d DATABASE_URL",
    "seed:load": "tsx src/scripts/seedLoad.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@seatsync/shared": "workspace:*",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.9.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
